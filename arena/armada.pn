conditions:
	# 0. Win: no enemy ships left (on once the reinforcements are in).
	*	disabled:  true
		when:
			type:    "ships"
			op:      "eq"
			player:  1
			value:   0
		action:
			*	type:    "win"
				player:  0
				text:
					>	The armada is destroyed.
	# 1. At 60 s, Cantharan reinforcements arrive from the east; the win can count from now.
	*	when:
			type:      "time"
			op:        "ge"
			duration:  "60s"
		action:
			*	type:       "message"
				reflexive:  true
				pages:
					*	>	Cantharan reinforcements are jumping in from the east!
			*	type:       "reveal"
				reflexive:  true
				initial:    [21, 22, 23, 24, 25, 26]
			*	type:       "condition"
				reflexive:  true
				enable:     [0]
