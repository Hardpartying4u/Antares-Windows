conditions:
	# 0. Win: the Gaitori have no ships left (on after 5 s).
	*	disabled:  true
		when:
			type:    "ships"
			op:      "eq"
			player:  1
			value:   0
		action:
			*	type:    "win"
				player:  0
				text:
					>	The Gaitori fleet is destroyed.
	# 1. After 5 s, turn on condition 0.
	*	when:
			type:      "time"
			op:        "ge"
			duration:  "5s"
		action:
			*	type:       "condition"
				reflexive:  true
				enable:     [0]
par:
	time:    "5m"
	kills:   14
	losses:  0
no_ships:  "Your fleet was destroyed."
