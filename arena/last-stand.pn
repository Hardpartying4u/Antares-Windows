conditions:
	# 0. Win: no enemy ships left (on once the last wave is in).
	*	disabled:  true
		when:
			type:    "ships"
			op:      "eq"
			player:  1
			value:   0
		action:
			*	type:    "win"
				player:  0
				text:
					>	The bunker held. All three waves are destroyed.
	# 1. Lose: the flagship is destroyed.
	*	when:
			type:    "destroyed"
			op:      "eq"
			object:  {initial: 0}
			value:   true
		action:
			*	type:    "win"
				player:  1
				text:
					>	Your flagship was destroyed.
	# 2. Lose: the bunker is knocked out (a station that is destroyed turns neutral) or taken.
	*	when:
			type:    "owner"
			op:      "ne"
			object:  {initial: 3}
			player:  0
		action:
			*	type:    "win"
				player:  1
				text:
					>	The bunker has fallen.
	# 3. At 50 s, the second wave arrives from the east.
	*	when:
			type:      "time"
			op:        "ge"
			duration:  "50s"
		action:
			*	type:       "message"
				reflexive:  true
				pages:
					*	>	Second wave: Gaitori heavy units from the east!
			*	type:       "reveal"
				reflexive:  true
				initial:    [10, 11, 12, 13, 14, 15, 16]
	# 4. At 100 s, the third wave arrives from the west; the win can count from now.
	*	when:
			type:      "time"
			op:        "ge"
			duration:  "100s"
		action:
			*	type:       "message"
				reflexive:  true
				pages:
					*	>	Third wave: Cantharan and Salrilian ships from the west!
			*	type:       "reveal"
				reflexive:  true
				initial:    [17, 18, 19, 20, 21, 22, 23, 24]
			*	type:       "condition"
				reflexive:  true
				enable:     [0]
par:
	time:    "6m"
	kills:   21
	losses:  0
